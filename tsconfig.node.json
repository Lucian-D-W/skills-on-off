  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "outDir": "dist-electron"
  },
  "include": ["src/main", "src/shared"]
}
